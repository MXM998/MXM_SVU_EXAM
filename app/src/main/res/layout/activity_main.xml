<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/cyber_background"
    android:padding="20dp"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_gravity="center">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginBottom="40dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="حساب معدل النجاح"
                android:textColor="@color/neon_pink"
                android:textSize="42sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:shadowColor="@color/neon_pink"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="20" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EXAM CALCULATE"
                android:textColor="@color/cyber_blue"
                android:textSize="18sp"
                android:textStyle="bold"
                android:letterSpacing="0.2"
                android:shadowColor="@color/cyber_blue"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="10" />

        </LinearLayout>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="25dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/glass_dark"
            android:layout_marginBottom="24dp"
            app:cardUseCompatPadding="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                android:background="@drawable/glass_effect">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="علامة الوظيفة"
                    android:textColor="@color/text_cyber"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="16dp" />

                <EditText
                    android:id="@+id/etAssignment"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:inputType="numberDecimal"
                    android:hint="أدخال علامة الوظيفة"
                    android:textColor="@color/text_neon"
                    android:textColorHint="@color/cyber_blue"
                    android:textSize="18sp"
                    android:padding="20dp"
                    android:background="@drawable/cyber_input"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnCalculateMin"
                    android:layout_width="wrap_content"
                    android:layout_height="50dp"
                    android:text="حساب الحد الأدنى"
                    android:layout_gravity="center"
                    android:layout_marginTop="20dp"
                    android:paddingStart="30dp"
                    android:paddingEnd="30dp"
                    android:background="@drawable/cyber_button"
                    android:textColor="@color/text_neon"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/neon_border"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="بدون علامات مساعدة"
                            android:textColor="@color/text_cyber"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvMinWithoutHelp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0.00"
                            android:textColor="@color/matrix_green"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:shadowColor="@color/matrix_green"
                            android:shadowDx="0"
                            android:shadowDy="0"
                            android:shadowRadius="8" />

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/glass_blue"
                        android:layout_marginVertical="10dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="مع علامات مساعدة"
                            android:textColor="@color/text_cyber"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvMinWithHelp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0.00"
                            android:textColor="@color/electric_purple"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:shadowColor="@color/electric_purple"
                            android:shadowDx="0"
                            android:shadowDy="0"
                            android:shadowRadius="8" />

                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="25dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/glass_purple"
            android:layout_marginBottom="24dp"
            app:cardUseCompatPadding="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                android:background="@drawable/glass_effect">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="علامة الأمتحان"
                    android:textColor="@color/text_cyber"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="16dp" />

                <EditText
                    android:id="@+id/etExam"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:inputType="numberDecimal"
                    android:hint="أدخل علامة الأمتحان"
                    android:textColor="@color/text_neon"
                    android:textColorHint="@color/neon_pink"
                    android:textSize="18sp"
                    android:padding="20dp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnCalculateFinal"
                    android:layout_width="wrap_content"
                    android:layout_height="50dp"
                    android:text="حساب المحصلة"
                    android:layout_gravity="center"
                    android:layout_marginTop="20dp"
                    android:paddingStart="30dp"
                    android:paddingEnd="30dp"
                    android:textColor="@color/text_neon"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="25dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/glass_blue"
            app:cardUseCompatPadding="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                android:background="@drawable/glass_effect">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="FINAL RESULT"
                    android:textColor="@color/text_cyber"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="16dp"
                    android:gravity="center" />

                <RelativeLayout
                    android:layout_width="150dp"
                    android:layout_height="150dp"
                    android:layout_gravity="center"
                    android:background="@drawable/circle_result"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tvResult"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.00"
                        android:textColor="@color/text_neon"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:layout_centerInParent="true" />

                </RelativeLayout>

                <TextView
                    android:id="@+id/tvResultMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textSize="16sp"
                    android:layout_marginTop="16dp"
                    android:text="Enter marks and calculate final grade"
                    android:textColor="@color/text_cyber" />

                <!-- مؤشر الحالة -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="20dp"
                    android:orientation="horizontal"
                    android:layout_marginTop="16dp"
                    android:gravity="center">

                    <View
                        android:id="@+id/indicatorSuccess"
                        android:layout_width="0dp"
                        android:layout_height="8dp"
                        android:layout_weight="1"
                        android:background="@color/matrix_green"
                        android:alpha="0.3" />

                    <View
                        android:id="@+id/indicatorWarning"
                        android:layout_width="0dp"
                        android:layout_height="8dp"
                        android:layout_weight="1"
                        android:background="@color/neon_pink"
                        android:alpha="0.3" />

                    <View
                        android:id="@+id/indicatorError"
                        android:layout_width="0dp"
                        android:layout_height="8dp"
                        android:layout_weight="1"
                        android:background="@color/cyber_blue"
                        android:alpha="0.3" />

                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>