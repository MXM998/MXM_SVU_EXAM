<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- علامة الوظيفة -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="علامة الوظيفة"
            android:textSize="18sp"
            android:layout_marginEnd="8dp" />

        <EditText
            android:id="@+id/etAssignment"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:inputType="numberDecimal"
            android:hint="أدخل العلامة" />

    </LinearLayout>

    <!-- زر حساب الحد الأدنى -->
    <Button
        android:id="@+id/btnCalculateMin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="حساب الحد الأدنى"
        android:layout_gravity="center"
        android:layout_marginTop="16dp" />

    <!-- نتائج الحد الأدنى -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="الحد الأدنى بدون مساعدة:"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvMinWithoutHelp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="الحد الأدنى مع مساعدة:"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvMinWithHelp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- علامة الامتحان -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="علامة الامتحان"
        android:textSize="18sp"
        android:layout_marginTop="32dp" />

    <EditText
        android:id="@+id/etExam"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="numberDecimal"
        android:hint="أدخل علامة الامتحان"
        android:layout_marginTop="8dp" />

    <!-- النتيجة -->
    <TextView
        android:id="@+id/tvResult"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:gravity="center"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginTop="32dp"
        android:background="#f0f0f0"
        android:text="النتيجة"
        android:textColor="#000000" />

</LinearLayout>