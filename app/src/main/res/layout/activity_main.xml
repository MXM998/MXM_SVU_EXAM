<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A1A"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvAppTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="SVU EXAM"
        android:textColor="#00D4FF"
        android:textSize="32sp"
        android:textStyle="bold"
        android:gravity="center"
        android:shadowColor="#00D4FF"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="20"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvDeveloper"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Developed by MXM"
        android:textColor="#60FFFFFF"
        android:textSize="10sp"
        android:padding="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvAppTitle"
        android:layout_marginTop="4dp" />

    <androidx.cardview.widget.CardView
        android:id="@+id/cardAssignment"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:cardCornerRadius="20dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="#801E1E2E"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvDeveloper"
        android:layout_marginTop="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="@drawable/glass_effect">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="علامة الوظيفة"
                android:textColor="#E0E0FF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/etAssignment"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:inputType="numberDecimal"
                android:hint="أدخل العلامة الوظيفة من 100"
                android:textColor="#FFFFFF"
                android:textColorHint="#00D4FF"
                android:textSize="16sp"
                android:padding="16dp"
                android:background="@drawable/cyber_input"
                android:textStyle="bold"
                android:gravity="center" />

            <Button
                android:id="@+id/btnCalculateMin"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="حساب الحد الأدنى لعلامة الأمتحان"
                android:layout_gravity="center"
                android:layout_marginTop="16dp"
                android:paddingStart="32dp"
                android:paddingEnd="32dp"
                android:background="@drawable/cyber_button"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- نتائج الحد الأدنى -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="20dp"
                android:background="@drawable/neon_border"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="الحد الأدنى بدون مساعدة"
                        android:textColor="#E0E0FF"
                        android:textSize="14sp"
                        android:paddingEnd="16dp" />

                    <TextView
                        android:id="@+id/tvMinWithoutHelp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.00"
                        android:textColor="#00FF88"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:shadowColor="#00FF88"
                        android:shadowDx="0"
                        android:shadowDy="0"
                        android:shadowRadius="8"
                        android:paddingStart="16dp"
                        android:minWidth="60dp" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#4000D4FF"
                    android:layout_marginVertical="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="الحد الأدنى مع مساعدة"
                        android:textColor="#E0E0FF"
                        android:textSize="14sp"
                        android:paddingEnd="16dp" />

                    <TextView
                        android:id="@+id/tvMinWithHelp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.00"
                        android:textColor="#FF00FF"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:shadowColor="#FF00FF"
                        android:shadowDx="0"
                        android:shadowDy="0"
                        android:shadowRadius="8"
                        android:paddingStart="16dp"
                        android:minWidth="60dp" />

                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- بطاقة علامة الامتحان -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardExam"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:cardCornerRadius="20dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="#801A1A3A"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cardAssignment"
        android:layout_marginTop="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="@drawable/glass_effect">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="علامة الامتحان"
                android:textColor="#E0E0FF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/etExam"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:inputType="numberDecimal"
                android:hint="أدخل العلامة الفحص من 100"
                android:textColor="#FFFFFF"
                android:textColorHint="#FF00FF"
                android:textSize="16sp"
                android:padding="16dp"
                android:background="@drawable/cyber_input_pink"
                android:textStyle="bold"
                android:gravity="center" />

            <Button
                android:id="@+id/btnCalculateFinal"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="حساب النتيجة النهائية"
                android:layout_gravity="center"
                android:layout_marginTop="16dp"
                android:paddingStart="32dp"
                android:paddingEnd="32dp"
                android:background="@drawable/cyber_button_pink"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- بطاقة النتيجة -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardResult"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:cardCornerRadius="20dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="#802A2A5A"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cardExam"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="@drawable/glass_effect"
            android:gravity="center">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="النتيجة النهائية"
                android:textColor="#E0E0FF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginBottom="16dp" />

            <!-- دائرة النتيجة -->
            <RelativeLayout
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:background="@drawable/circle_result"
                android:gravity="center">

                <TextView
                    android:id="@+id/tvResult"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0.00"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:layout_centerInParent="true" />

            </RelativeLayout>

            <TextView
                android:id="@+id/tvResultMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textSize="14sp"
                android:layout_marginTop="12dp"
                android:text="أدخل العلامات لحساب النتيجة"
                android:textColor="#E0E0FF" />

            <!-- مؤشر الحالة -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:orientation="horizontal"
                android:layout_marginTop="16dp"
                android:gravity="center">

                <View
                    android:id="@+id/indicatorSuccess"
                    android:layout_width="0dp"
                    android:layout_height="6dp"
                    android:layout_weight="1"
                    android:background="#00FF88"
                    android:alpha="0.3"
                    android:layout_marginHorizontal="2dp" />

                <View
                    android:id="@+id/indicatorWarning"
                    android:layout_width="0dp"
                    android:layout_height="6dp"
                    android:layout_weight="1"
                    android:background="#FF00FF"
                    android:alpha="0.3"
                    android:layout_marginHorizontal="2dp" />

                <View
                    android:id="@+id/indicatorError"
                    android:layout_width="0dp"
                    android:layout_height="6dp"
                    android:layout_weight="1"
                    android:background="#00D4FF"
                    android:alpha="0.3"
                    android:layout_marginHorizontal="2dp" />

            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>



</androidx.constraintlayout.widget.ConstraintLayout>